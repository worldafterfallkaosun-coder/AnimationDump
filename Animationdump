-- pasangkan klik terakhir dengan animasi yang baru mulai (urutan boleh kebalik: track dulu baru klik)
local function tryLearn()
	local lc, lt = lastClick, lastTrack
	if not (CFG.LEARN and lc and lt and lt.e and lc.btn and lc.btn.Parent) then
		return false
	end
	if lt.t < lc.t - 0.3 or lt.t - lc.t > CFG.CLICK_WINDOW then
		return false
	end
	local okI, bi = pcall(lightInfo, lc.btn)
	if not (okI and bi and bi.ctx and (bi.ctx.emote or CFG.LEARN_ANY)) then
		return false
	end
	lastClick, lastTrack = nil, nil
	local useBi = bi
	if not bi.ctx.emote then
		useBi = { label = bi.label, ctx = { emote = true } }
	end
	local e = lt.e
	if addGuiEntry(e.id, useBi, "click", lc.btn) then
		bi.ids = bi.ids or {}
		bi.ids[#bi.ids + 1] = e.id
		setStatus("learn: " .. ((bi.label or "") ~= "" and bi.label or e.name) .. " -> " .. assetUrl(e.id))
		return true
	end
	return false
end

local function requeueVisible(sg)
	task.delay(0.4, function()
		if not alive or not sg or not sg.Parent then
			return
		end
		ctxCache = setmetatable({}, { __mode = "k" })
		headerCache = setmetatable({}, { __mode = "k" })
		for _, d in ipairs(sg:GetDescendants()) do
			local cn = d.ClassName
			if (cn == "TextButton" or cn == "ImageButton") and guiVisible(d) then
				btnInfo[d] = nil
				if not queuedBtn[d] then
					queuedBtn[d] = true
					btnQueue[#btnQueue + 1] = d
				end
			end
		end
	end)
end

local function onButtonClick(btn)
	if not alive then
		return
	end
	local okAll = pcall(function()
		local bi = btnInfo[btn]
		local raw = ""
		if btn.ClassName == "TextButton" then
			raw = trim(stripTags(btn.Text))
		end
		if raw == "" then
			raw = btn.Name
		end
		local kind = ctxKind(raw)
		local isItem = bi and bi.ids and #bi.ids > 0
		if (kind == "dance" or kind == "emote") and not isItem and #raw <= 24 then
			local sg = screenGuiOf(btn)
			if sg then
				activeTab[sg] = { cat = kind, t = os.clock() }
				lastClick = nil
				requeueVisible(sg)
			end
		else
			lastClick = { btn = btn, t = os.clock() }
			tryLearn()
		end
	end)
	if not okAll then
		lastClick = nil
	end
end

local function queueButton(btn, force)
	if not CFG.SCAN_GUI or isOwnGui(btn) then
		return
	end
	if not hooked[btn] then
		hooked[btn] = true
		keep(btn.Activated:Connect(function()
			local _ = SELF_TAG
			onButtonClick(btn)
		end))
	end
	if queuedBtn[btn] and not force then
		return
	end
	queuedBtn[btn] = true
	btnQueue[#btnQueue + 1] = btn
end

local function queueAllButtons(force)
	if not playerGui then
		return 0
	end
	local n = 0
	local ok, desc = pcall(playerGui.GetDescendants, playerGui)
	if not ok then
		return 0
	end
	for i, d in ipairs(desc) do
		local cn = d.ClassName
		if cn == "TextButton" or cn == "ImageButton" then
			if force then
				btnInfo[d] = nil
			end
			queueButton(d, force)
			n = n + 1
		end
		if i % 1500 == 0 then
			task.wait()
		end
	end
	return n
end

local function waitQueueDrain(timeout)
	local t0 = os.clock()
	while alive and (#btnQueue > 0 or workerBusy) and os.clock() - t0 < timeout do
		task.wait(0.1)
	end
end

