status.Text = "nunggu animasi ketemu..."
status.TextColor3 = Color3.fromRGB(160, 160, 175)
status.Font = Enum.Font.Gotham
status.TextSize = 11
status.TextXAlignment = Enum.TextXAlignment.Left
