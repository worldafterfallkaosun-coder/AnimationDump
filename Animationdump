local function screenGuiOf(inst)
	local cur, n = inst, 0
	while cur and n < 40 do
		if cur:IsA("LayerCollector") then
			return cur
		end
		cur = cur.Parent
		n = n + 1
	end
	return nil
end

local function guiVisible(inst)
	local cur, n = inst, 0
	while cur and n < 40 do
		if cur:IsA("GuiObject") then
			if not cur.Visible then
				return false
			end
		elseif cur:IsA("LayerCollector") then
			return cur.Enabled ~= false
		end
		cur = cur.Parent
		n = n + 1
	end
	return true
end

-- konteks dari nama leluhur (nama terdekat yang nyebut dance/emote menang)
local function ancestorCtx(inst)
	if inst == nil then
		return { emote = false }
	end
	local c = ctxCache[inst]
	if c then
		return c
	end
	local parentCtx
	if inst:IsA("LayerCollector") or inst.Parent == nil then
		parentCtx = { emote = false }
	else
		parentCtx = ancestorCtx(inst.Parent)
	end
	c = { emote = parentCtx.emote, cat = parentCtx.cat, how = parentCtx.how }
	local k = ctxKind(inst.Name)
	if k then
		c.emote = true
		if k == "dance" or k == "emote" then
			c.cat = k
			c.how = inst.Name
		elseif not c.how then
			c.how = inst.Name
		end
	end
	ctxCache[inst] = c
	return c
end

-- header section ("Dances", "Emotes") di antara saudara-saudara tombol
local function headersOf(parent)
	local h = headerCache[parent]
	if h then
		return h
	end
	h = {}
	for _, c in ipairs(parent:GetChildren()) do
		if c:IsA("GuiObject") and not c:IsA("GuiButton") then
			local txt, hasBtn
			if c:IsA("TextLabel") then
				txt = c.Text
			else
				local kids = c:GetChildren()
				if #kids <= 8 then
					for _, k in ipairs(kids) do
						if k:IsA("GuiButton") then
							hasBtn = true
							break
						end
						if k:IsA("TextLabel") and not txt then
							txt = k.Text
						end
					end
				end
			end
			if not hasBtn then
				local kind = (txt and #txt <= 40 and ctxKind(stripTags(txt))) or ctxKind(c.Name)
				if kind == "dance" or kind == "emote" then
					local pos = c.AbsolutePosition
					h[#h + 1] = { y = pos.Y, x = pos.X, cat = kind, text = txt or c.Name }
				end
			end
		end
	end
	headerCache[parent] = h
	return h
end

local function sectionCat(btn)
	local node = btn
	for _ = 1, 3 do
		local parent = node.Parent
		if not parent or parent:IsA("LayerCollector") then
			break
		end
		local hs = headersOf(parent)
		if #hs > 0 then
			local pos = node.AbsolutePosition
			local best
			for _, hd in ipairs(hs) do
				if hd.y <= pos.Y + 2 and (not best or hd.y > best.y or (hd.y == best.y and hd.x > best.x)) then
					best = hd
				end
			end
			if best then
				return best.cat, best.text
			end
		end
		node = parent
	end
	return nil
end

local function contextOf(btn)
	local a = ancestorCtx(btn.Parent)
	local ctx = { emote = a.emote, cat = a.cat, lv = a.cat and 3 or nil, how = a.how }
	local ok, hc, ht = pcall(sectionCat, btn)
	if ok and hc then
		ctx.emote = true
		ctx.cat = hc
		ctx.lv = 3
		ctx.how = ht
	end
	if not ctx.cat then
		local sg = screenGuiOf(btn)
		local tab = sg and activeTab[sg]
		if tab and os.clock() - tab.t < 1800 and guiVisible(btn) then
			ctx.emote = true
			ctx.cat = tab.cat
			ctx.lv = 2
			ctx.how = "tab:" .. tab.cat
		end
	end
	return ctx
end

-- tombol yang dibungkus cell (Frame isinya 1 tombol + label/value/animation)
local function isCell(par, btn)
	if not par or par:IsA("LayerCollector") or par:IsA("ScrollingFrame") then
		return false
	end
	local kids = par:GetChildren()
	if #kids > 12 then
		return false
	end
	for _, k in ipairs(kids) do
		if k:IsA("GuiButton") and k ~= btn then
			return false
		end
	end
	return true
end

local function labelOf(btn)
	local txt = ""
	if btn.ClassName == "TextButton" then
		txt = guiLabelClean(btn.Text)
	end
	if txt == "" then
		local ok, desc = pcall(btn.GetDescendants, btn)
		if ok then
			for i, d in ipairs(desc) do
				if i > 30 then
					break
				end
				if d.ClassName == "TextLabel" or d.ClassName == "TextButton" then
					local t = guiLabelClean(d.Text)
					if t ~= "" then
						txt = t
						break
					end
				end
			end
		end
	end
	local par = btn.Parent
	local cell = isCell(par, btn)
	if txt == "" and cell then
		for _, k in ipairs(par:GetChildren()) do
			if k.ClassName == "TextLabel" then
				local t = guiLabelClean(k.Text)
				if t ~= "" then
					txt = t
					break
				end
			end
		end
	end
	if txt == "" then
		txt = guiLabelClean(stripSuffix(btn.Name))
	end
	if txt == "" and cell then
		txt = guiLabelClean(stripSuffix(par.Name))
	end
	return txt
end

local function lightInfo(btn)
	local bi = btnInfo[btn]
	if bi and bi.ctx then
		return bi
	end
	bi = bi or {}
	bi.label = bi.label or labelOf(btn)
	bi.ctx = contextOf(btn)
	btnInfo[btn] = bi
	return bi
end

-- ---- ekstraksi ID dari tombol ---------------------------------------------
local NAME_KEYS = { name = true, displayname = true, title = true, label = true, emotename = true, text = true }
local CAT_KEYS = {
	category = true, type = true, tab = true, group = true, genre = true,
	section = true, kind = true, class = true, categoryname = true,
}

-- table data emote -> {id, st, name, cat}  (st = kekuatan bukti 1..3)
local function itemFromTable(t)
	local bestId, bestSt, name, cat
	local n = 0
	for k, v in pairs(t) do
		n = n + 1
		if n > 60 then
			break
		end
		if type(k) == "string" then
			local lk = k:lower()
			local tv = type(v)
			if NAME_KEYS[lk] and tv == "string" then
				if not name then
					name = v
				end
			elseif CAT_KEYS[lk] and tv == "string" then
				local kind = ctxKind(v)
				if kind == "dance" or kind == "emote" then
					cat = kind
				end
			else
				local st = idKeyStrength(k)
				if st > 0 then
					local id
					if tv == "string" or tv == "number" then
						id = parseIdMin(v, 5)
					elseif typeof(v) == "Instance" and v:IsA("Animation") then
						id = parseId(v.AnimationId)
						st = 3
					end
					if id and (not bestSt or st > bestSt) then
						bestId, bestSt = id, st
					end
				end
			end
		end
	end
	if not bestId then
		return nil
	end
	return { id = bestId, st = bestSt, name = name, cat = cat }
end

local function pushCand(list, seen, id, st, how, name, cat)
	if not id or seen[id] then
		return
	end
	seen[id] = true
	list[#list + 1] = { id = id, st = st, how = how, name = name, cat = cat }
end

local function scanAttrs(inst, list, seen, tag)
	local ok, attrs = pcall(inst.GetAttributes, inst)
	if not ok or type(attrs) ~= "table" then
		return
	end
	for k, v in pairs(attrs) do
		local st = idKeyStrength(k)
		local tv = type(v)
		if (tv == "string" or tv == "number") and st >= 0 then
			if tv == "string" and v:lower():find("rbxassetid", 1, true) then
				st = math.max(st, 2)
			end
			if st > 0 then
				pushCand(list, seen, parseIdMin(v, 5), st, tag .. "@" .. tostring(k))
			end
		end
	end
end

local function scanValues(inst, list, seen, emoteCtx)
	local ok, desc = pcall(inst.GetDescendants, inst)
	if not ok then
		return
	end
	for i, d in ipairs(desc) do
		if i > 40 then
			break
		end
		local cn = d.ClassName
		if cn == "Animation" then
			pushCand(list, seen, parseIdMin(d.AnimationId, 3), emoteCtx and 3 or 2, "anim")
		elseif cn == "StringValue" or cn == "IntValue" or cn == "NumberValue" then
			local st = idKeyStrength(d.Name)
			if st >= 0 then
				pushCand(list, seen, parseIdMin(d.Value, 5), st == 0 and 1 or st, "value")
			end
		elseif cn == "ObjectValue" then
			local v = d.Value
			if v and v.ClassName == "Animation" then
				pushCand(list, seen, parseIdMin(v.AnimationId, 3), emoteCtx and 3 or 2, "objvalue")
			end
		end
	end
end

local function normName(s)
	return (tostring(s or ""):lower():gsub("[^%w]+", ""))
end

local function buildNameIndex()
	nameIndex = {}
	for _, e in ipairs(order) do
		if e.inst and not e.dead and not isGenericName(e.name) then
			local k = normName(stripSuffix(e.name))
			if #k >= 3 then
				local l = nameIndex[k]
				if not l then
					l = {}
					nameIndex[k] = l
				end
				l[#l + 1] = e
			end
		end
	end
end

local function linkByName(btn, bi, list, seen)
	local keys = { normName(bi.label), normName(stripSuffix(btn.Name)) }
	if btn.Parent then
		keys[#keys + 1] = normName(stripSuffix(btn.Parent.Name))
	end
	for _, k in ipairs(keys) do
		local l = (#k >= 3) and nameIndex[k] or nil
		if l then
			local pick, count = nil, 0
			for _, e in ipairs(l) do
				if not e.char and not e.move then
					pick = e
					count = count + 1
				end
			end
			if count == 1 then
				pushCand(list, seen, pick.id, 2, "name")
				return
			end
		end
	end
end

local inspectFunction
local function inspectValue(v, list, seen, depth, how)
	local tv = type(v)
	if tv == "string" then
		if v:lower():find("rbxassetid", 1, true) then
			pushCand(list, seen, parseIdMin(v, 5), 2, how)
		end
	elseif tv == "function" then
		if depth < 1 then
			inspectFunction(v, list, seen, depth + 1, how)
		end
	elseif tv == "table" then
		if depth < 2 then
			local it = itemFromTable(v)
			if it then
				pushCand(list, seen, it.id, it.st, how .. ":tbl", it.name, it.cat)
			else
				-- koleksi: cuma dipercaya kalau isinya tepat 1 item (kalau banyak = ambigu)
				local found1, count, n = nil, 0, 0
				for _, x in pairs(v) do
					n = n + 1
					if n > 60 then
						break
					end
					if type(x) == "table" then
						local it2 = itemFromTable(x)
						if it2 then
							found1 = it2
							count = count + 1
						end
					end
				end
				if count == 1 then
					pushCand(list, seen, found1.id, found1.st, how .. ":tbl1", found1.name, found1.cat)
				end
			end
		end
	elseif typeof(v) == "Instance" then
		if v:IsA("Animation") then
			pushCand(list, seen, parseIdMin(v.AnimationId, 3), 3, how .. ":anim")
		end
	end
end

inspectFunction = function(f, list, seen, depth, how)
	if getUps then
		local okU, ups = pcall(getUps, f)
		if okU and type(ups) == "table" then
			if depth == 0 then
				for _, v in pairs(ups) do
					if v == SELF_TAG then
						return -- handler punya kita sendiri
					end
				end
			end
			local n = 0
			for _, v in pairs(ups) do
				n = n + 1
				if n > 40 then
					break
				end
				pcall(inspectValue, v, list, seen, depth, how)
			end
		end
	end
	if depth == 0 and getConsts then
		local okC, cs = pcall(getConsts, f)
		if okC and type(cs) == "table" then
			local n = 0
			for _, v in pairs(cs) do
				n = n + 1
				if n > 200 then
					break
				end
				if type(v) == "string" and v:lower():find("rbxassetid", 1, true) then
					pushCand(list, seen, parseIdMin(v, 5), 2, how .. ":const")
				end
			end
		end
	end
end

local function scanConnections(btn, list, seen)
	if not (getConns and (getUps or getConsts)) then
		return
	end
	for _, sigName in ipairs({ "Activated", "MouseButton1Click" }) do
		local ok, cs = pcall(function()
			return getConns(btn[sigName])
		end)
		if ok and type(cs) == "table" then
			for i, c in ipairs(cs) do
				if i > 6 then
					break
				end
				local f
				pcall(function()
					f = c.Function
				end)
				if type(f) == "function" then
					pcall(inspectFunction, f, list, seen, 0, "conn")
				end
			end
		end
	end
end

local function extractCandidates(btn, ctx, bi)
	local list, seen = {}, {}
	pcall(scanAttrs, btn, list, seen, "attr")
	pcall(scanValues, btn, list, seen, ctx.emote)
	local par = btn.Parent
	if isCell(par, btn) then
		pcall(scanAttrs, par, list, seen, "cell")
		pcall(scanValues, par, list, seen, ctx.emote)
	end
	if ctx.emote then
		pcall(linkByName, btn, bi, list, seen)
		if CFG.SCAN_CONNECTIONS then
			pcall(scanConnections, btn, list, seen)
		end
	end
	return list
end

local function addGuiEntry(id, bi, how, btn, cand)
	local ctx = bi.ctx or { emote = true }
	local cat, lv = ctx.cat, ctx.lv
	if cand and cand.cat then
		cat, lv = cand.cat, 3
	end
	local label = bi.label or ""
	if cand and cand.name and guiLabelClean(cand.name) ~= "" then
		label = guiLabelClean(cand.name)
	end
	return add(id, label ~= "" and label or "?", how .. ":" .. safeFullName(btn), {
		gui = true,
		guiName = label,
		cat = cat,
		lv = lv,
	})
end

local function analyzeButton(btn)
	local bi = { label = labelOf(btn) }
	btnInfo[btn] = bi
	bi.ctx = contextOf(btn)
	local cands = extractCandidates(btn, bi.ctx, bi)
	if #cands > 0 then
		bi.ids = {}
		local weakLeft = 3
		for _, c in ipairs(cands) do
			local accept = false
			if c.st >= 3 then
				accept = true
			elseif bi.ctx.emote then
				if c.st >= 2 then
					accept = true
				elseif weakLeft > 0 then
					weakLeft = weakLeft - 1
					accept = isAnimAsset(c.id)
				end
			end
			if accept then
				local e = addGuiEntry(c.id, bi, c.how, btn, c)
				if e then
					bi.ids[#bi.ids + 1] = c.id
				end
			end
		end
	end
	bi.done = true
	return bi
end

