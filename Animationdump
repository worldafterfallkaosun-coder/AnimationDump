-- Bagian murni (tanpa API Roblox): tabel data -> XML model Roblox + helper teks.
-- data = {
--   Loop=bool, Priority=int, HipHeight=number?,
--   Keyframes = { {Time=n, Name=s, Poses={pose...}, Markers={{Name=,Value=}}} }
-- }
-- pose = {Name, CFrame={x,y,z,r00..r22}, EasingStyle=int, EasingDirection=int, Weight, Children={pose...}}
-- item = {name=, data=, assetId=?, group=?}   (group -> dibungkus Folder)
local function esc(s)
	s = tostring(s == nil and "" or s)
	if utf8 and utf8.len and not utf8.len(s) then
		s = s:gsub("[\128-\255]", "?") -- UTF-8 rusak -> XML ga valid, buang byte tinggi
	end
	s = s:gsub("[\0-\8\11\12\14-\31\127]", "")
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	s = s:gsub('"', "&quot;")
	return s
end

local function num(n)
	n = tonumber(n) or 0
	if n ~= n or n == math.huge or n == -math.huge then
		return "0"
	end
	return string.format("%.9g", n)
end

local CF_KEYS = { "X", "Y", "Z", "R00", "R01", "R02", "R10", "R11", "R12", "R20", "R21", "R22" }

local function toXML(list)
	local out = {
		'<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">',
	}
	local ref = 0

	local function put(s)
		out[#out + 1] = s
	end

	local function open(class, name)
		ref = ref + 1
		put('<Item class="' .. class .. '" referent="RBX' .. ref .. '">')
		put("<Properties>")
		put('<string name="Name">' .. esc(name) .. "</string>")
	end

	local function emitPose(p)
		open("Pose", p.Name)
		local c = p.CFrame or {}
		put('<CoordinateFrame name="CFrame">')
		for i = 1, 12 do
			local default = (i == 4 or i == 8 or i == 12) and 1 or 0 -- identity kalau data kosong
			put("<" .. CF_KEYS[i] .. ">" .. num(c[i] or default) .. "</" .. CF_KEYS[i] .. ">")
		end
		put("</CoordinateFrame>")
		put('<token name="EasingDirection">' .. num(p.EasingDirection) .. "</token>")
		put('<token name="EasingStyle">' .. num(p.EasingStyle) .. "</token>")
		put('<float name="Weight">' .. num(p.Weight == nil and 1 or p.Weight) .. "</float>")
		put("</Properties>")
		for _, child in ipairs(p.Children or {}) do
			emitPose(child)
		end
		put("</Item>")
	end

	local function emitItem(item)
		local data = item.data
		-- item.assetId (mis. "rbxassetid://123") -> objek Animation di samping KeyframeSequence
		if item.assetId then
			open("Animation", item.name)
			put('<Content name="AnimationId"><url>' .. esc(item.assetId) .. "</url></Content>")
			put("</Properties>")
			put("</Item>")
		end
		open("KeyframeSequence", item.name)
		put('<bool name="Loop">' .. (data.Loop and "true" or "false") .. "</bool>")
		put('<token name="Priority">' .. num(data.Priority) .. "</token>")
		if data.HipHeight then
			put('<float name="AuthoredHipHeight">' .. num(data.HipHeight) .. "</float>")
		end
		put("</Properties>")
		for _, kf in ipairs(data.Keyframes) do
			open("Keyframe", kf.Name or "Keyframe")
			put('<float name="Time">' .. num(kf.Time) .. "</float>")
			put("</Properties>")
			for _, p in ipairs(kf.Poses or {}) do
				emitPose(p)
			end
			for _, m in ipairs(kf.Markers or {}) do
				open("KeyframeMarker", m.Name)
				put('<string name="Value">' .. esc(m.Value or "") .. "</string>")
				put("</Properties>")
				put("</Item>")
			end
			put("</Item>")
		end
		put("</Item>")
	end

	local groups, gorder, loose = {}, {}, {}
	for _, item in ipairs(list) do
		local g = item.group
		if g and g ~= "" then
			if not groups[g] then
				groups[g] = {}
				gorder[#gorder + 1] = g
			end
			local t = groups[g]
			t[#t + 1] = item
		else
			loose[#loose + 1] = item
		end
	end
	for _, item in ipairs(loose) do
		emitItem(item)
	end
	for _, g in ipairs(gorder) do
		open("Folder", g)
		put("</Properties>")
		for _, item in ipairs(groups[g]) do
			emitItem(item)
		end
		put("</Item>")
	end

	put("</roblox>")
	return table.concat(out, "\n")
end

-- "123" / 123 / "rbxassetid://123" / "http://www.roblox.com/asset/?id=123" / ".../catalog/123/x" -> "123"
local function parseId(raw)
	if raw == nil then
		return nil
	end
	local s
	if type(raw) == "number" then
		if raw ~= raw or raw < 1 or raw >= 1e16 then
			return nil
		end
		s = string.format("%.0f", raw) -- tostring() bisa jadi "1.2e+14" buat id 15 digit
	elseif type(raw) == "string" then
		s = raw
	else
		return nil
	end
	local id = s:match("[Rr][Bb][Xx][Aa][Ss][Ss][Ee][Tt][Ii][Dd]://%s*(%d+)")
		or s:match("[%?&][Ii][Dd]=(%d+)")
		or s:match("[%?&][Aa][Ss][Ss][Ee][Tt][Ii][Dd]=(%d+)")
		or s:match("/[Cc]atalog/(%d+)")
		or s:match("/[Ll]ibrary/(%d+)")
		or s:match("^%s*(%d+)%s*$")
	if not id then
		return nil
	end
	id = id:gsub("^0+", "")
	if id == "" or #id > 16 then
		return nil
	end
	return id
end

-- sama kayak parseId tapi minimal N digit (buat ID dari GUI/data biar angka kecil ga kebaca ID)
local function parseIdMin(raw, minDigits)
	local id = parseId(raw)
	if id and #id >= minDigits then
		return id
	end
	return nil
end

-- "123" -> "rbxassetid://123"
local function assetUrl(id)
	return "rbxassetid://" .. tostring(id)
end

local function trim(s)
	return (tostring(s or ""):match("^%s*(.-)%s*$"))
end

local function stripTags(s)
	s = tostring(s or "")
	s = s:gsub("<[^>]*>", "")
	return s
end

-- nama generik = bukan nama asli ("Animation", "Animation3", "?", kosong, angka doang)
local GENERIC = {
	[""] = true,
	["?"] = true,
	anim = true,
	keyframesequence = true,
	unnamed = true,
	untitled = true,
	default = true,
	template = true,
}
local function isGenericName(n)
	if type(n) ~= "string" then
		return true
	end
	local k = (n:gsub("%s+", "")):lower()
	return GENERIC[k] == true or k:match("^animation%d*$") ~= nil or k:match("^%d+$") ~= nil
end

-- "FlossDance_2 emote" -> {"floss","dance","emote"} (camelCase dipecah, angka/simbol dibuang)
local function tokens(s)
	s = tostring(s == nil and "" or s)
	s = s:gsub("(%l)(%u)", "%1 %2")
	s = s:gsub("(%u)(%u%l)", "%1 %2")
	s = s:lower()
	s = s:gsub("[^%a]+", " ")
	local t = {}
	for w in s:gmatch("%S+") do
		t[#t + 1] = w
	end
	return t
end

local function isDanceTok(t)
	return t:sub(1, 4) == "danc" or t:sub(-5) == "dance" or t == "tari" or t == "joget" or t == "goyang"
end

local function isEmoteTok(t)
	return t:sub(1, 5) == "emote" or t == "emoticon" or t == "emoticons" or t == "gesture" or t == "gestures"
end

-- kata kunci kategori STRICT (buat nama tab/frame/header GUI): "dance" | "emote" | "both" | nil
local function ctxKind(s)
	local d, e = false, false
	for _, t in ipairs(tokens(s)) do
		if isDanceTok(t) then
			d = true
		elseif isEmoteTok(t) then
			e = true
		end
	end
	if d and e then
		return "both"
	end
	if d then
		return "dance"
	end
	if e then
		return "emote"
	end
	return nil
end

-- tebakan kategori dari NAMA animasi doang (lebih longgar, cuma ngenalin dance)
local DANCE_WORDS = {
	groove = true, boogie = true, disco = true, ballet = true, salsa = true, tango = true,
	waltz = true, twerk = true, moonwalk = true, floss = true, shuffle = true, breakdance = true,
	macarena = true, tarian = true, joged = true, hiphop = true,
}
local function nameCat(s)
	for _, t in ipairs(tokens(s)) do
		if isDanceTok(t) or DANCE_WORDS[t] then
			return "dance"
		end
	end
	return nil
end

-- sufiks umum nama tombol/frame yang bukan bagian nama emote ("FlossButton" -> "Floss")
local SUFFIXES = { "Button", "Btn", "Frame", "Template", "Holder", "Slot", "Item", "Emote" }
local function stripSuffix(n)
	n = trim(n)
	local changed = true
	while changed do
		changed = false
		for _, suf in ipairs(SUFFIXES) do
			if #n > #suf + 1 and n:sub(-#suf):lower() == suf:lower() then
				n = n:sub(1, #n - #suf)
				n = n:gsub("[_%-%s]+$", "")
				changed = true
				break
			end
		end
	end
	return n
end

-- label GUI -> nama bersih, "" kalau cuma noise (Button, Frame, angka, harga, kepanjangan)
local GUI_NOISE = {
	button = true, btn = true, textbutton = true, imagebutton = true, frame = true, template = true,
	item = true, holder = true, slot = true, emote = true, emotes = true, dance = true, dances = true,
	label = true, text = true, icon = true, image = true, clone = true, example = true, new = true,
	container = true, cell = true, tile = true, card = true, option = true, entry = true,
}
local function guiLabelClean(raw)
	local s = trim(stripTags(tostring(raw or "")))
	if s == "" or #s > 48 then
		return ""
	end
	local letters = (s:gsub("[^%a\128-\255]", ""))
	if #letters < 2 then
		return "" -- angka / simbol / harga ("R$ 50") doang
	end
	local toks = tokens(s)
	if #toks > 0 then
		local allNoise = true
		for _, t in ipairs(toks) do
			if not GUI_NOISE[t] then
				allNoise = false
				break
			end
		end
		if allNoise then
			return ""
		end
	end
	return s
end

-- pilih nama terbaik: (nama GUI) > nama asset katalog > nama instance/track > "Animation"
local function pickName(assetName, instName, guiName, preferGui)
	if preferGui and type(guiName) == "string" and guiName ~= "" and not isGenericName(guiName) then
		return trim(guiName)
	end
	if not isGenericName(assetName) then
		return trim(assetName)
	end
	if not isGenericName(instName) then
		return trim(instName)
	end
	if type(guiName) == "string" and guiName ~= "" and not isGenericName(guiName) then
		return trim(guiName)
	end
	-- semuanya generik: pakai yang ada isinya, kalau ga ada ya "Animation"
	local a, i = trim(assetName), trim(instName)
	if a ~= "" and a ~= "?" then
		return a
	end
	if i ~= "" and i ~= "?" then
		return i
	end
	return "Animation"
end

-- nama -> aman buat nama file (ASCII, tanpa spasi/simbol)
local function safeName(s)
	s = tostring(s or "Animation")
	s = s:gsub("[^%w_%-]+", "_")
	s = s:gsub("_+", "_")
	s = s:gsub("^_+", "")
	s = s:gsub("_+$", "")
	if #s > 60 then
		s = s:sub(1, 60)
		s = s:gsub("_+$", "")
	end
	if s == "" then
		s = "Animation"
	end
	return s
end

-- nama key (attribute/field) -> seberapa kuat petunjuk "ini ID animasi"
-- 3 = emote*, 2 = anim*/dance*, 1 = id/assetid, 0 = netral, -1 = jelas bukan (icon, userid, price, ...)
local KEY_BAD = {
	"icon", "image", "thumb", "user", "player", "gamepass", "product", "place", "universe", "group",
	"badge", "sound", "audio", "mesh", "texture", "decal", "shirt", "pants", "price", "color", "order",
	"index", "layout", "sort", "zindex", "level", "rarity", "count", "amount", "version", "slot",
}
local function idKeyStrength(k)
	if type(k) ~= "string" then
		return 0
	end
	local l = k:lower()
	for _, bad in ipairs(KEY_BAD) do
		if l:find(bad, 1, true) then
			return -1
		end
	end
	if l:find("emote", 1, true) then
		return 3
	end
	if l:find("anim", 1, true) or l:find("dance", 1, true) then
		return 2
	end
	if l == "id" or l == "assetid" or l == "asset" or l == "rbxid" or l:sub(-2) == "id" then
		return 1
	end
	return 0
end
