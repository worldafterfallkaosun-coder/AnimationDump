local function refreshList()
	local counts = { ALL = 0, GUI = 0, DANCE = 0, EMOTE = 0, LAIN = 0 }
	local view, selN, selInView = {}, 0, 0
	for _, e in ipairs(order) do
		if not e.dead then
			counts.ALL = counts.ALL + 1
			if e.inGui then
				counts.GUI = counts.GUI + 1
				if catOf(e) == "dance" then
					counts.DANCE = counts.DANCE + 1
				else
					counts.EMOTE = counts.EMOTE + 1
				end
			else
				counts.LAIN = counts.LAIN + 1
			end
			if e.sel then
				selN = selN + 1
			end
			if inMode(e, filterMode) and matchQuery(e, searchText) then
				view[#view + 1] = e
				if e.sel then
					selInView = selInView + 1
				end
			end
		end
	end

	local keys = {}
	for _, e in ipairs(view) do
		local c = catOf(e)
		keys[e] = {
			e.inGui and 0 or 1,
			(c == "dance") and 1 or ((c == "emote") and 2 or 3),
			dispName(e):lower(),
		}
	end
	table.sort(view, function(a, b)
		local ka, kb = keys[a], keys[b]
		if ka[1] ~= kb[1] then
			return ka[1] < kb[1]
		end
		if ka[2] ~= kb[2] then
			return ka[2] < kb[2]
		end
		if ka[3] ~= kb[3] then
			return ka[3] < kb[3]
		end
		return a.id < b.id
	end)

	local shown = {}
	for i, e in ipairs(view) do
		if i <= CFG.MAX_ROWS then
			if not e.row then
				buildRow(e)
			end
			e.row.Visible = true
			e.row.LayoutOrder = i
			e.refresh()
			shown[e] = true
		end
	end
	for _, e in ipairs(order) do
		if e.row and not shown[e] then
			e.row.Visible = false
		end
	end
	-- buang baris tersembunyi kalau kebanyakan (hemat memori)
	if builtRows > CFG.MAX_ROWS * 2 + 100 then
		for _, e in ipairs(order) do
			if e.row and not shown[e] then
				pcall(function()
					e.row:Destroy()
				end)
				e.row, e.refresh = nil, nil
				builtRows = builtRows - 1
			end
		end
	end

	for name, b in pairs(ui.chips) do
		local label = (name == "ALL") and "SEMUA" or name
		b.Text = label .. " " .. counts[name]
		b.BackgroundColor3 = (filterMode == name) and COL.chipOn or COL.chipOff
	end
	if selN > 0 then
		ui.dumpBtn.Text = "DUMP SEL (" .. selN .. ")"
	else
		ui.dumpBtn.Text = "DUMP (" .. #view .. ")"
	end
	ui.title.Text = ("Anim Dump v2  %d | GUI %d (D %d / E %d)"):format(counts.ALL, counts.GUI, counts.DANCE, counts.EMOTE)
	ui.learnBtn.Text = CFG.LEARN and "LEARN ON" or "LEARN OFF"
	ui.learnBtn.BackgroundColor3 = CFG.LEARN and COL.green or COL.grey
	ui.fmtBtn.Text = "." .. string.upper(CFG.FORMAT == "rbxm" and "rbxm" or "rbxmx")
	ui.viewSize = #view
end

local function stopAll()
	cancelFlag = true
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0.1)
		end)
	end
	setStatus("stopped / dibatalin")
end

local function destroy()
	alive = false
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0)
		end)
	end
	if gui then
		pcall(function()
			gui:Destroy()
		end)
	end
	if env.AnimRip and env.AnimRip.list == order then
		env.AnimRip = nil
	end
end

local function wireButtons()
	keep(ui.closeBtn.Activated:Connect(destroy))
	keep(ui.scanBtn.Activated:Connect(rescan))
	keep(ui.autoBtn.Activated:Connect(autoClick))
	keep(ui.stopBtn.Activated:Connect(stopAll))
	keep(ui.learnBtn.Activated:Connect(function()
		CFG.LEARN = not CFG.LEARN
		markDirty()
	end))
	keep(ui.fmtBtn.Activated:Connect(function()
		CFG.FORMAT = (CFG.FORMAT == "rbxm") and "rbxmx" or "rbxm"
		setStatus("format output: ." .. CFG.FORMAT)
		markDirty()
	end))
	keep(ui.search:GetPropertyChangedSignal("Text"):Connect(function()
		searchText = trim(ui.search.Text):lower()
		markDirty()
	end))
	keep(ui.selBtn.Activated:Connect(function()
		for _, e in ipairs(currentView()) do
			e.sel = true
			if e.refresh then
				e.refresh()
			end
		end
		markDirty()
	end))
	keep(ui.clrBtn.Activated:Connect(function()
		for _, e in ipairs(order) do
			e.sel = nil
			if e.refresh then
				e.refresh()
			end
		end
		markDirty()
	end))
	keep(ui.dumpBtn.Activated:Connect(function()
		local list, label = dumpTargets()
		task.spawn(dumpEntries, list, label)
	end))
	keep(ui.allBtn.Activated:Connect(function()
		task.spawn(dumpAll)
	end))
end

