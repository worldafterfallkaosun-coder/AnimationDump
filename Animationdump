local BLACK = {}
for w in
	("buy purchase robux shop store gamepass pass close exit cancel stop setting settings search clear delete remove report trade gift donate redeem premium vip favorite favourite fav star heart like equip unequip bind keybind assign save edit rename reset")
		:gmatch("%S+")
do
	BLACK[w] = true
end

local function isBlacklisted(btn, bi)
	for _, src in ipairs({ bi.label or "", btn.Name, btn.Parent and btn.Parent.Name or "" }) do
		for _, t in ipairs(tokens(src)) do
			if BLACK[t] then
				return true
			end
		end
	end
	return false
end

local function snapshotTracks(animator)
	local set = {}
	local ok, tracks = pcall(function()
		return animator:GetPlayingAnimationTracks()
	end)
	if ok and type(tracks) == "table" then
		for _, t in ipairs(tracks) do
			set[t] = true
		end
	end
	return set
end

-- nunggu track baru (bukan idle/walk) muncul di animator
local function waitNewTrack(animator, before, timeout)
	local t0 = os.clock()
	while alive and not cancelFlag and os.clock() - t0 < timeout do
		local ok, tracks = pcall(function()
			return animator:GetPlayingAnimationTracks()
		end)
		if ok and type(tracks) == "table" then
			for _, tr in ipairs(tracks) do
				if not before[tr] then
					local anim = tr.Animation
					local id = anim and parseId(anim.AnimationId)
					local known = id and found[id]
					if id and not (known and known.move) then
						return tr
					end
					before[tr] = true
				end
			end
		end
		task.wait(0.05)
	end
	return nil
end

local function fireButton(btn)
	local fired = false
	if getConns then
		for _, sigName in ipairs({ "Activated", "MouseButton1Click" }) do
			local ok, cs = pcall(function()
				return getConns(btn[sigName])
			end)
			if ok and type(cs) == "table" then
				for _, c in ipairs(cs) do
					local okf = pcall(function()
						c:Fire()
					end)
					if not okf then
						pcall(function()
							c.Function()
						end)
					end
					fired = true
				end
			end
		end
	end
	if not fired and fireSig then
		fired = pcall(fireSig, btn.Activated)
	end
	return fired
end

local function autoWork()
	local animator, hum = getAnimator(false)
	if not animator then
		setStatus("auto: karakter / animator belum ada")
		return
	end
	if not (getConns or fireSig) then
		setStatus("auto: executor ga punya getconnections / firesignal")
	end
	setStatus("auto: scan dulu...")
	scanNative()
	if CFG.SCAN_GUI then
		queueAllButtons(true)
		waitQueueDrain(25)
	end
	local newCount, clicks = 0, 0

	-- 1. emote wheel yang ID-nya ga bisa di-load langsung -> tarik lewat PlayEmote
	if hum then
		local list = {}
		for _, e in ipairs(order) do
			if e.native and not e.dead and not e.nativeTried then
				list[#list + 1] = e
			end
		end
		for i, e in ipairs(list) do
			if cancelFlag or not alive then
				break
			end
			e.nativeTried = true
			if not fetchData(e.id) then
				setStatus(("auto: PlayEmote %d/%d %s"):format(i, #list, tostring(e.native)))
				local before = snapshotTracks(animator)
				pcall(function()
					hum:PlayEmote(e.native)
				end)
				local tr = waitNewTrack(animator, before, CFG.AUTO_WAIT + 0.6)
				if tr and tr.Animation then
					local nid = parseId(tr.Animation.AnimationId)
					if nid and nid ~= e.id then
						add(nid, e.native, "wheel>" .. tostring(e.native), {
							gui = e.inGui == true,
							guiName = e.guiName or e.native,
							cat = e.cat,
							lv = e.catLv,
							slot = e.slot,
							native = e.native,
						})
						e.dead = true
						newCount = newCount + 1
					end
				end
				if tr then
					pcall(function()
						tr:Stop(0.1)
					end)
				end
				task.wait(CFG.AUTO_GAP)
			end
		end
	end

	-- 2. klik otomatis tombol emote di GUI
	local targets = {}
	for btn, bi in pairs(btnInfo) do
		if
			bi.ctx
			and bi.ctx.emote
			and btn.Parent
			and not (bi.ids and #bi.ids > 0)
			and not isOwnGui(btn)
			and not isBlacklisted(btn, bi)
		then
			local raw = btn.ClassName == "TextButton" and trim(stripTags(btn.Text)) or ""
			local kind = ctxKind(raw ~= "" and raw or btn.Name)
			if not ((kind == "dance" or kind == "emote") and #raw <= 24) then -- skip tombol tab
				targets[#targets + 1] = btn
			end
		end
	end
	table.sort(targets, function(a, b)
		return safeFullName(a) < safeFullName(b)
	end)
	if #targets > CFG.AUTO_MAX then
		for i = #targets, CFG.AUTO_MAX + 1, -1 do
			targets[i] = nil
		end
	end
	for i, btn in ipairs(targets) do
		if cancelFlag or not alive then
			break
		end
		local bi = btnInfo[btn]
		if bi and btn.Parent then
			setStatus(("auto: klik %d/%d %s"):format(i, #targets, bi.label ~= "" and bi.label or btn.Name))
			local before = snapshotTracks(animator)
			if fireButton(btn) then
				clicks = clicks + 1
				local tr = waitNewTrack(animator, before, CFG.AUTO_WAIT)
				if tr and tr.Animation then
					local id = parseId(tr.Animation.AnimationId)
					if id then
						local isNew = found[id] == nil or not found[id].inGui
						if addGuiEntry(id, bi, "auto", btn) then
							bi.ids = bi.ids or {}
							bi.ids[#bi.ids + 1] = id
							if isNew then
								newCount = newCount + 1
							end
						end
					end
					pcall(function()
						tr:Stop(0.1)
					end)
				end
				task.wait(CFG.AUTO_GAP)
			end
		end
	end
	local g, d, em = countGui()
	setStatus(("auto selesai: %d klik, +%d emote baru | GUI %d (dance %d / emote %d)"):format(clicks, newCount, g, d, em))
	markDirty()
end

local function autoClick()
	if autoRunning then
		cancelFlag = true
		setStatus("auto: dihentikan")
		return
	end
	autoRunning = true
	cancelFlag = false
	if ui.autoBtn then
		ui.autoBtn.Text = "AUTO..."
	end
	task.spawn(function()
		local ok, err = pcall(autoWork)
		autoRunning = false
		if ui.autoBtn then
			ui.autoBtn.Text = "AUTO"
		end
		if not ok then
			setStatus("auto error: " .. tostring(err):sub(1, 70))
		end
	end)
end

