local function scanNative()
	if not CFG.SCAN_NATIVE then
		return 0
	end
	local hum = getHumanoid()
	if not hum then
		return 0
	end
	local desc
	pcall(function()
		desc = hum:GetAppliedDescription()
	end)
	if not desc then
		desc = hum:FindFirstChildOfClass("HumanoidDescription")
	end
	if not desc then
		return 0
	end
	local okE, emotes = pcall(function()
		return desc:GetEmotes()
	end)
	local okQ, equipped = pcall(function()
		return desc:GetEquippedEmotes()
	end)
	local slotOf = {}
	if okQ and type(equipped) == "table" then
		for _, it in ipairs(equipped) do
			if type(it) == "table" and it.Name then
				slotOf[it.Name] = it.Slot
			end
		end
	end
	local n = 0
	if okE and type(emotes) == "table" then
		for name, ids in pairs(emotes) do
			local raw = ids
			if type(ids) == "table" then
				raw = ids[1]
			end
			local slot = slotOf[name]
			local inWheel = slot ~= nil
			local e = add(raw, name, inWheel and ("wheel#" .. tostring(slot)) or "emote:owned", {
				gui = inWheel or CFG.OWNED_EMOTES_AS_GUI,
				guiName = name,
				cat = "emote",
				lv = 0.5,
				slot = slot,
				native = name,
			})
			if e then
				n = n + 1
			end
		end
	end
	return n
end

local function addDataEntry(it, cat, src)
	local c = it.cat or cat
	local accept = it.st >= 2
	if not accept then
		accept = isAnimAsset(it.id) -- ID lemah (cuma "Id") harus lolos cek katalog
	end
	if not accept then
		return
	end
	add(it.id, it.name or "?", "data:" .. src, {
		gui = true,
		guiName = it.name,
		cat = c,
		lv = c and 3 or nil,
	})
end

local function walkData(t, cat, depth, visited, budget, src)
	if depth > 7 or budget.n <= 0 or visited[t] then
		return
	end
	visited[t] = true
	budget.n = budget.n - 1
	local it = itemFromTable(t)
	if it then
		addDataEntry(it, cat, src)
		return
	end
	for k, v in pairs(t) do
		if budget.n <= 0 then
			return
		end
		local tv = type(v)
		if tv == "table" then
			local kcat = cat
			if type(k) == "string" then
				local kk = ctxKind(k)
				if kk == "dance" or kk == "emote" then
					kcat = kk
				end
			end
			walkData(v, kcat, depth + 1, visited, budget, src)
		elseif type(k) == "string" and (tv == "string" or tv == "number") and idKeyStrength(k) == 0 then
			-- bentuk peta: ["Floss"] = 1234567890
			local id = parseIdMin(v, 6)
			if id then
				budget.n = budget.n - 1
				addDataEntry({ id = id, st = 2, name = k }, cat, src)
			end
		end
	end
end

local function scanModules()
	if not CFG.SCAN_MODULES or not getMods then
		return 0
	end
	local ok, mods = pcall(getMods)
	if not ok or type(mods) ~= "table" then
		return 0
	end
	local before = #order
	for i, m in ipairs(mods) do
		if not alive then
			break
		end
		local full = safeFullName(m)
		local kind = ctxKind(full)
		if kind and not isOwnGui(m) then
			local okr, res = pcall(require, m)
			if okr and type(res) == "table" then
				local cat = (kind == "dance" or kind == "emote") and kind or nil
				pcall(walkData, res, cat, 0, {}, { n = 6000 }, full)
			end
		end
		if i % 20 == 0 then
			task.wait()
		end
	end
	return #order - before
end

