local function readPose(pose)
	local e = {
		Name = pose.Name,
		CFrame = { pose.CFrame:GetComponents() },
		EasingStyle = pose.EasingStyle.Value,
		EasingDirection = pose.EasingDirection.Value,
		Weight = pose.Weight,
		Children = {},
	}
	for _, sub in ipairs(pose:GetChildren()) do
		if sub:IsA("Pose") then
			e.Children[#e.Children + 1] = readPose(sub)
		end
	end
	return e
end

local function readSequence(ks)
	local data = {
		Loop = ks.Loop,
		Priority = ks.Priority.Value,
		Keyframes = {},
	}
	pcall(function()
		data.HipHeight = ks.AuthoredHipHeight
	end)
	for _, kf in ipairs(ks:GetKeyframes()) do
		local k = { Time = kf.Time, Name = kf.Name, Poses = {}, Markers = {} }
		for _, c in ipairs(kf:GetChildren()) do
			if c:IsA("Pose") then
				k.Poses[#k.Poses + 1] = readPose(c)
			elseif c:IsA("KeyframeMarker") then
				k.Markers[#k.Markers + 1] = { Name = c.Name, Value = c.Value }
			end
		end
		data.Keyframes[#data.Keyframes + 1] = k
	end
	table.sort(data.Keyframes, function(a, b)
		return a.Time < b.Time
	end)
	return data
end

local function isTransient(err)
	err = tostring(err):lower()
	return err:find("%f[%d]429%f[%D]") ~= nil
		or err:find("throttl", 1, true) ~= nil
		or err:find("too many", 1, true) ~= nil
		or err:find("timed out", 1, true) ~= nil
		or err:find("timeout", 1, true) ~= nil
		or err:find("%f[%d]5%d%d%f[%D]") ~= nil
end

-- ambil KeyframeSequence: KSP dulu, fallback GetObjects
local function loadSequence(id)
	local url = assetUrl(id)
	local ok, ks = pcall(function()
		return KSP:GetKeyframeSequenceAsync(url)
	end)
	if ok and ks then
		return ks
	end
	local err1 = ok and "kosong" or tostring(ks)
	local ok2, objs = pcall(function()
		return game:GetObjects(url)
	end)
	if ok2 and type(objs) == "table" then
		local curve = false
		for _, o in ipairs(objs) do
			if o:IsA("KeyframeSequence") then
				return o
			end
			local nested = o:FindFirstChildWhichIsA("KeyframeSequence", true)
			if nested then
				return nested
			end
			if o:IsA("CurveAnimation") then
				curve = true
			end
		end
		if curve then
			return nil, err1 .. " | CurveAnimation (belum didukung)"
		end
		err1 = err1 .. " | GetObjects: ga ada KeyframeSequence"
	else
		err1 = err1 .. " | GetObjects: " .. tostring(objs)
	end
	return nil, err1
end

local function loadOnce(id)
	local ks, err = loadSequence(id)
	if not ks then
		return nil, err
	end
	local ok, data = pcall(readSequence, ks)
	pcall(function()
		ks:Destroy()
	end)
	if not ok then
		return nil, tostring(data)
	end
	if #data.Keyframes == 0 then
		return nil, "kosong (0 keyframe)"
	end
	return data
end

-- single-flight + retry kalau error sementara + cache gagal 45 detik (force = abaikan cache gagal)
local function fetchData(id, force)
	local hit = cache[id]
	if hit then
		return hit
	end
	local f = failCache[id]
	if f and not force and os.clock() - f.t < 45 then
		return nil, f.err
	end
	if inflight[id] then
		while inflight[id] and alive do
			task.wait(0.05)
		end
		return cache[id], failCache[id] and failCache[id].err
	end
	inflight[id] = true
	local data, err
	for attempt = 1, CFG.FETCH_RETRIES + 1 do
		local ok, d, e = pcall(loadOnce, id)
		if ok and d then
			data = d
			break
		end
		err = ok and e or d
		if not isTransient(err) then
			break
		end
		task.wait(attempt * 0.7)
	end
	inflight[id] = nil
	if data then
		cache[id] = data
		failCache[id] = nil
		return data
	end
	err = tostring(err or "gagal"):sub(1, 160)
	failCache[id] = { err = err, t = os.clock() }
	return nil, err
end

----------------------------------------------------------------
-- Katalog Roblox (nama asli + tipe asset)
----------------------------------------------------------------
local PENDING = {}
local infoCache = {} -- id -> info table | false (gagal permanen) | PENDING
local infoFailAt = {} -- id -> waktu gagal sementara (rate limit)
local nextInfoAt = 0

local function fetchInfo(id)
	local info, transient
	for attempt = 1, CFG.NAME_RETRIES do
		local now = os.clock()
		local at = math.max(nextInfoAt, now)
		nextInfoAt = at + CFG.INFO_SPACING
		if at > now then
			task.wait(at - now)
		end
		local ok, res = pcall(function()
			return MPS:GetProductInfo(tonumber(id), Enum.InfoType.Asset)
		end)
		if ok and type(res) == "table" then
			info = res
			break
		end
		if ok then
			break -- balasan aneh, jangan diulang
		end
		transient = isTransient(res)
		if not transient or attempt == CFG.NAME_RETRIES then
			break
		end
		task.wait(attempt) -- backoff kalau kena rate limit
	end
	return info, transient
end

-- info asset dari katalog; di-cache. Yield. Gagal permanen (private/dihapus) = nil, ga di-retry.
-- Gagal sementara (rate limit) = nil juga, tapi boleh dicoba lagi setelah 20 detik.
local function getInfo(id)
	local c = infoCache[id]
	while c == PENDING and alive do
		task.wait(0.1)
		c = infoCache[id]
	end
	if c == PENDING then
		return nil
	end
	if c ~= nil then
		return c or nil
	end
	local fa = infoFailAt[id]
	if fa and os.clock() - fa < 20 then
		return nil
	end
	infoCache[id] = PENDING
	local ok, info, transient = pcall(fetchInfo, id)
	if not ok then
		info, transient = nil, true
	end
	if info then
		infoCache[id] = info
		infoFailAt[id] = nil
		return info
	end
	if transient then
		infoCache[id] = nil
		infoFailAt[id] = os.clock()
	else
		infoCache[id] = false
	end
	return nil
end

-- ID ini beneran animasi/emote? (katalog dulu, kalau katalog ga jawab coba load keyframe-nya)
local function isAnimAsset(id)
	local info = getInfo(id)
	if info then
		return info.AssetTypeId == 24 or info.AssetTypeId == 61
	end
	return fetchData(id) ~= nil
end

