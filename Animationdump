	status.Text = t
end

setCount = function(n)
	title.Text = "Anim ID Dump (" .. n .. ")"
end

-- drag lewat title (mouse & touch)
do
	local dragging, startInput, startPos
	keep(title.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = i.Position
			startPos = main.Position
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
				end
			end)
		end
	end))
	keep(UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startInput
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
end

addRow = function(e)
	if rowCount >= MAX_ROWS then
		if rowCount == MAX_ROWS then
			rowCount = rowCount + 1
			setStatus("list GUI penuh (" .. MAX_ROWS .. "), sisanya tetap ikut DUMP ALL")
		end
		return
	end
	rowCount = rowCount + 1

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -6, 0, 44)
	row.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
	row.BorderSizePixel = 0
	row.Parent = list
	corner(row, 5)

	local lbl = Instance.new("TextLabel")
	lbl.Position = UDim2.fromOffset(6, 2)
	lbl.Size = UDim2.new(1, -128, 1, -4)
	lbl.BackgroundTransparency = 1
	lbl.Text = e.name .. "\n" .. e.id
	lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.Parent = row

	local playB = mkButton(row, "PLAY", UDim2.new(1, -118, 0.5, -12), UDim2.fromOffset(52, 24), Color3.fromRGB(50, 90, 150))
	local copyB = mkButton(row, "COPY", UDim2.new(1, -62, 0.5, -12), UDim2.fromOffset(56, 24), Color3.fromRGB(50, 120, 80))

	keep(playB.Activated:Connect(function()
		task.spawn(function()
			setStatus("load animasi...")
			local ok, err = playId(e.id)
			setStatus(ok and ("playing: " .. e.name) or ("gagal play: " .. tostring(err):sub(1, 60)))
		end)
	end))

	keep(copyB.Activated:Connect(function()
		local url = assetUrl(e.id)
		if copy(url) then
			setStatus("dicopy: " .. url)
		else
			setStatus("ga ada setclipboard, id: " .. url)
		end
	end))
end

keep(allBtn.Activated:Connect(dumpAll))

keep(stopBtn.Activated:Connect(function()
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0.1)
		end)
		setStatus("stopped")
	end
end))

keep(clrBtn.Activated:Connect(function()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	setStatus("list GUI dibersihin (data tetap ada, DUMP ALL masih lengkap)")
end))

----------------------------------------------------------------
-- Jalanin scanner
----------------------------------------------------------------
task.spawn(function()
	local n = 0
	for _, d in ipairs(game:GetDescendants()) do
		pcall(onInstance, d)
		n = n + 1
		if n % 2000 == 0 then
			task.wait()
		end
	end
	if type(getnilinstances) == "function" then
		for _, root in ipairs(getnilinstances()) do
			pcall(onInstance, root)
			pcall(function()
				for _, d in ipairs(root:GetDescendants()) do
					onInstance(d)
				end
			end)
		end
	end
end)

keep(game.DescendantAdded:Connect(function(d)
	pcall(onInstance, d)
end))

task.spawn(function()
	while alive do
		for animator in pairs(animators) do
			if animator.Parent == nil then
				animators[animator] = nil
			else
				pcall(function()
					for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
						local anim = tr.Animation
						if anim then
							add(anim.AnimationId, tr.Name, "playing@" .. safeFullName(animator))
						end
					end
				end)
			end
		end
		task.wait(POLL_INTERVAL)
	end
end)

----------------------------------------------------------------
-- Cleanup + API
----------------------------------------------------------------
local function destroy()
	alive = false
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0)
		end)
	end
	gui:Destroy()
end

keep(closeBtn.Activated:Connect(destroy))

env.AnimRip = {
	dumpAll = dumpAll,
	ids = ids,
	list = order,
	destroy = destroy,
}

print("[AnimRip] jalan. Tekan COPY di baris animasi, atau DUMP ALL buat simpan semua ID.")
