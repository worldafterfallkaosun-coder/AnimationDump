local MOVE_NAMES = {
	idle = true, walk = true, run = true, jump = true, fall = true, climb = true, swim = true,
	swimidle = true, sit = true, toolnone = true, toolslash = true, toollunge = true, mood = true, landed = true,
}
local EMOTE_FOLDERS = {
	wave = "emote", point = "emote", laugh = "emote", cheer = "emote",
	dance = "dance", dance1 = "dance", dance2 = "dance", dance3 = "dance",
}
local LIST_ROOTS = {
	ReplicatedStorage = true, ReplicatedFirst = true, StarterGui = true, StarterPlayer = true,
	StarterPack = true, Lighting = true,
}

local function animEvidence(inst)
	local char, move, folderCat, kindCat, listRoot = false, false, nil, nil, false
	local cur, top, n = inst.Parent, nil, 0
	while cur and cur ~= game and n < 24 do
		n = n + 1
		local nm = cur.Name
		local ln = nm:lower()
		if MOVE_NAMES[ln] then
			move = true
		end
		if EMOTE_FOLDERS[ln] and not folderCat then
			folderCat = EMOTE_FOLDERS[ln]
		end
		if ln == "animate" then
			char = true
		end
		if not char and cur.ClassName == "Model" and cur:FindFirstChildOfClass("Humanoid") then
			char = true
		end
		if cur.ClassName == "PlayerGui" then
			listRoot = true
		end
		local k = ctxKind(nm)
		if k and not kindCat then
			kindCat = k
		end
		top = cur
		cur = cur.Parent
	end
	if top and LIST_ROOTS[top.ClassName] then
		listRoot = true
	end
	if cur == nil and top then
		listRoot = true -- tree nil-parent (getnilinstances)
	end
	local ev = {}
	if char then
		ev.char = true
		if folderCat then
			ev.cat = folderCat
			ev.lv = 2
		end
	end
	if move then
		ev.move = true
	end
	if not char and listRoot and kindCat then
		ev.gui = true
		if kindCat == "dance" or kindCat == "emote" then
			ev.cat = kindCat
			ev.lv = 2
		end
	end
	return ev
end

