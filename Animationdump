-- Entry + bukti kategori (dance / emote / GUI)
----------------------------------------------------------------
-- ev = { gui=bool, cat="dance"|"emote", lv=number, guiName=, move=bool, char=bool, slot=, native= }
-- level bukti: 3 = GUI/data (tab, section, field Category) | 2 = folder Animate / tab terakhir diklik
--              1 = nama keyword / katalog | 0.5 = default emote
local function applyEv(e, ev)
	if not ev then
		return false
	end
	local changed = false
	if ev.gui and not e.inGui then
		e.inGui = true
		changed = true
	end
	if ev.guiName and ev.guiName ~= "" and not isGenericName(ev.guiName) then
		if e.guiName == nil or (ev.lv or 1) > (e.guiNameLv or 0) then
			if e.guiName ~= ev.guiName then
				e.guiName = ev.guiName
				e.realName = nil -- hitung ulang nama
				changed = true
			end
			e.guiNameLv = ev.lv or 1
		end
	end
	if ev.cat and (ev.lv or 0) > (e.catLv or 0) then
		e.cat = ev.cat
		e.catLv = ev.lv
		changed = true
	end
	if ev.move then
		e.move = true
	end
	if ev.char then
		e.char = true
	end
	if ev.slot then
		e.slot = ev.slot
	end
	if ev.native then
		e.native = ev.native
	end
	return changed
end

local function add(rawId, name, source, ev)
	if rawId == nil or rawId == "" then
		return nil
	end
	local id = parseId(rawId)
	if not id then
		return nil
	end
	local e = found[id]
	if e then
		local changed = applyEv(e, ev)
		if ev and ev.gui and not e.srcGui then
			e.srcGui = true
			e.source = source or e.source
			changed = true
		end
		if (e.name == "?" or isGenericName(e.name)) and name and not isGenericName(name) then
			e.name = name
			e.realName = nil
			changed = true
		end
		if changed then
			markDirty()
		end
		return e
	end
	e = { id = id, name = (name and name ~= "") and name or "?", source = source or "?", catLv = 0 }
	if ev and ev.gui then
		e.srcGui = true
	end
	found[id] = e
	order[#order + 1] = e
	applyEv(e, ev)
	local nc = nameCat(e.name)
	if not nc and e.guiName then
		nc = nameCat(e.guiName)
	end
	if nc then
		applyEv(e, { cat = nc, lv = 1 })
	end
	markDirty()
	return e
end

-- kategori akhir: "dance" | "emote" | "other"
local function catOf(e)
	if e.cat then
		return e.cat
	end
	if e.inGui then
		return "emote"
	end
	return "other"
end

local function folderOf(e)
	if e.inGui then
		return catOf(e) == "dance" and "GUI_Dance" or "GUI_Emote"
	end
	return "Other"
end

local function inMode(e, mode)
	if mode == "GUI" then
		return e.inGui == true
	elseif mode == "DANCE" then
		return e.inGui == true and catOf(e) == "dance"
	elseif mode == "EMOTE" then
		return e.inGui == true and catOf(e) == "emote"
	elseif mode == "LAIN" then
		return not e.inGui
	end
	return true
end

local function dispName(e)
	return e.realName or (CFG.PREFER_GUI_NAME and e.guiName) or e.name
end

local function matchQuery(e, q)
	if not q or q == "" then
		return true
	end
	local hay = (dispName(e) .. " " .. e.name .. " " .. e.id .. " " .. tostring(e.source or "")):lower()
	return hay:find(q, 1, true) ~= nil
end

local function currentView()
	local view = {}
	for _, e in ipairs(order) do
		if not e.dead and inMode(e, filterMode) and matchQuery(e, searchText) then
			view[#view + 1] = e
		end
	end
	return view
end

----------------------------------------------------------------
-- Nama asli
----------------------------------------------------------------
local function resolveName(e)
	if e.realName then
		return e.realName
	end
	local info = getInfo(e.id)
	if info then
		e.assetType = info.AssetTypeId
		local nc = nameCat(info.Name)
		if nc then
			applyEv(e, { cat = nc, lv = 1 })
		end
		if e.assetType == 61 then
			applyEv(e, { cat = "emote", lv = 0.5 })
		end
	end
	local name = pickName(info and info.Name, e.name, e.guiName, CFG.PREFER_GUI_NAME)
	e.realName = name
	markDirty()
	return name
end

-- antrean pelan buat label GUI (satu worker, ada jeda biar ga kena rate limit)
local nameQueue, queueRunning = {}, false
local function queueName(e, onDone)
	nameQueue[#nameQueue + 1] = { e = e, cb = onDone }
	if queueRunning then
		return
	end
	queueRunning = true
	task.spawn(function()
		while alive and #nameQueue > 0 do
			local job = table.remove(nameQueue, 1)
			local needNet = infoCache[job.e.id] == nil
			pcall(resolveName, job.e)
			if job.cb then
				pcall(job.cb)
			end
			if needNet then
				task.wait(CFG.NAME_DELAY)
			end
		end
		queueRunning = false
	end)
end

----------------------------------------------------------------
-- Tulis file
----------------------------------------------------------------
local folderReady = {}
local function ensureFolder(path)
	if folderReady[path] then
		return true
	end
	if not canWrite or not hasFolderApi then
		return false
	end
	local ok, exists = pcall(isfolder, path)
	if not (ok and exists) then
		pcall(makefolder, path)
		ok, exists = pcall(isfolder, path)
	end
	if ok and exists then
		folderReady[path] = true
		return true
	end
	return false
end

local function writeOut(sub, base, xml)
	if not canWrite then
		return nil
	end
	local ext = (CFG.FORMAT == "rbxm") and "rbxm" or "rbxmx"
	local dir = CFG.FOLDER
	ensureFolder(dir)
	local prefix = ""
	if sub and sub ~= "" and CFG.SUBFOLDERS then
		if ensureFolder(dir .. "/" .. sub) then
			dir = dir .. "/" .. sub
		else
			prefix = sub .. "_" -- executor ga bisa bikin subfolder -> prefix nama file
		end
	end
	local p = dir .. "/" .. prefix .. base .. "." .. ext
	if pcall(writefile, p, xml) then
		return p
	end
	-- beberapa executor nolak ekstensi asing -> .txt, tinggal rename ke .rbxmx
	p = dir .. "/" .. prefix .. base .. ".txt"
	if pcall(writefile, p, xml) then
		return p
	end
	return nil
end

local function dumpEntry(e)
	local data, err = fetchData(e.id)
	if not data then
		return nil, err
	end
	local name = resolveName(e)
	local item = { name = name, data = data, assetId = CFG.INCLUDE_ANIMATION_REF and assetUrl(e.id) or nil }
	local xml = toXML({ item })
	local path = writeOut(folderOf(e), safeName(name) .. "_" .. e.id, xml)
	if path then
		return path
	end
	if type(setclipboard) == "function" and pcall(setclipboard, xml) then
		return "clipboard (executor ga punya writefile)"
	end
	return nil, "ga bisa nulis file / clipboard"
end

local function dump(rawId)
	local id = parseId(rawId)
	if not id then
		return nil, "id ga valid"
	end
	local e = found[id] or { id = id, name = "?", source = "manual", catLv = 0 }
	return dumpEntry(e)
end

-- worker pool: fn(item, index) boleh yield
local function runPool(list, nThreads, fn)
	local idx, active, total = 0, 0, #list
	local function worker()
		while alive and not cancelFlag do
			idx = idx + 1
			local i = idx
			if i > total then
				break
			end
			local ok, err = pcall(fn, list[i], i)
			if not ok then
				log("worker error:", tostring(err))
			end
		end
		active = active - 1
	end
	for _ = 1, math.max(1, math.min(nThreads, total)) do
		active = active + 1
		task.spawn(worker)
	end
	while active > 0 do
		task.wait(0.1)
	end
end

local function dumpEntries(entries, label)
	if dumping then
		setStatus("masih dumping... tekan STOP buat batalin")
		return
	end
	if not canWrite then
		setStatus("executor ga punya writefile -> pakai tombol SAVE per animasi (ke clipboard)")
		return
	end
	dumping = true
	cancelFlag = false
	local list = {}
	for _, e in ipairs(entries) do
		if not e.dead then
			list[#list + 1] = e
		end
	end
	local total = #list
	if total == 0 then
		setStatus("ga ada animasi yang bisa di-dump (cek filter)")
		dumping = false
		return
	end
	local keyCache = {}
	for _, e in ipairs(list) do
		keyCache[e] = folderOf(e) .. "/" .. dispName(e):lower()
	end
	table.sort(list, function(a, b)
		local ka, kb = keyCache[a], keyCache[b]
		if ka ~= kb then
			return ka < kb
		end
		return a.id < b.id
	end)

	local fileLabel = safeName(label)
	local index, failed = {}, {}
	local okN, done, wroteFail = 0, 0, 0
	local nChunks = math.ceil(total / CFG.MAX_PER_FILE)
	local aggregated = 0

	for ci = 1, nChunks do
		if not alive or cancelFlag then
			break
		end
		local first = (ci - 1) * CFG.MAX_PER_FILE + 1
		local last = math.min(total, ci * CFG.MAX_PER_FILE)
		local slice, items, lines = {}, {}, {}
		for i = first, last do
			slice[#slice + 1] = list[i]
		end
		runPool(slice, CFG.DUMP_THREADS, function(e, si)
			local name = resolveName(e)
			local data, err = fetchData(e.id)
			done = done + 1
			setStatus(("dump %d/%d: %s"):format(done, total, name))
			local line = assetUrl(e.id)
				.. " | "
				.. (name:gsub("[\r\n|]+", " "))
				.. " | "
				.. catOf(e)
				.. (e.inGui and "+GUI" or "")
				.. " | "
				.. tostring(e.source):gsub("[\r\n]+", " ")
			lines[si] = line
			if data then
				local item = {
					name = name,
					data = data,
					assetId = CFG.INCLUDE_ANIMATION_REF and assetUrl(e.id) or nil,
					group = folderOf(e),
				}
				items[si] = item
				-- file satuan: KeyframeSequence langsung di root (kayak Reel.rbxm), tanpa Folder pembungkus
				local single = { name = item.name, data = item.data, assetId = item.assetId }
				if writeOut(folderOf(e), safeName(name) .. "_" .. e.id, toXML({ single })) then
					okN = okN + 1
				else
					wroteFail = wroteFail + 1
					lines[si] = line .. " | (gagal nulis file)"
				end
			else
				failed[#failed + 1] = line .. " | " .. tostring(err)
			end
			cache[e.id] = nil -- lepas memori, ga dipakai lagi
		end)
		local packed = {}
		for si = 1, #slice do
			if lines[si] then
				index[#index + 1] = lines[si]
			end
			if items[si] then
				packed[#packed + 1] = items[si]
			end
		end
		if #packed > 0 then
			local suffix = (nChunks > 1) and ("_" .. ci) or ""
			if writeOut(nil, "_" .. fileLabel .. suffix, toXML(packed)) then
				aggregated = aggregated + 1
			end
		end
		task.wait()
	end

	local idsName = (label == "ALL") and "_ids.txt" or ("_ids_" .. fileLabel .. ".txt")
	local failName = (label == "ALL") and "_failed.txt" or ("_failed_" .. fileLabel .. ".txt")
	ensureFolder(CFG.FOLDER)
	pcall(writefile, CFG.FOLDER .. "/" .. idsName, table.concat(index, "\n"))
	pcall(writefile, CFG.FOLDER .. "/" .. failName, table.concat(failed, "\n"))

	local note = cancelFlag and " (dibatalin, partial)" or ""
	setStatus(("selesai%s: %d ok, %d gagal -> %s/"):format(note, okN, #failed + wroteFail, CFG.FOLDER))
	log(("%s: %d ok, %d gagal. File ada di %s/"):format(label, okN, #failed + wroteFail, CFG.FOLDER))
	dumping = false
end

local function entriesFor(mode)
