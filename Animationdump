local function onTrack(animator, track, fromEvent)
	local anim = track.Animation
	if not anim then
		return
	end
	local e = add(anim.AnimationId, track.Name, "played@" .. safeFullName(animator))
	if fromEvent and e and not e.move and isLocalAnimator(animator) then
		lastTrack = { e = e, t = os.clock() }
		tryLearn()
	end
end

local function watchAnimator(animator)
	if animators[animator] then
		return
	end
	animators[animator] = true
	keep(animator.AnimationPlayed:Connect(function(track)
		pcall(onTrack, animator, track, true)
	end))
end

local function onInstance(inst)
	local cn = inst.ClassName
	if cn == "Animation" then
		local e = add(inst.AnimationId, inst.Name, safeFullName(inst), animEvidence(inst))
		if e then
			e.inst = true
		end
		keep(inst:GetPropertyChangedSignal("AnimationId"):Connect(function()
			local e2 = add(inst.AnimationId, inst.Name, safeFullName(inst), animEvidence(inst))
			if e2 then
				e2.inst = true
			end
		end))
	elseif cn == "Animator" then
		watchAnimator(inst)
	elseif CFG.SCAN_GUI and (cn == "TextButton" or cn == "ImageButton") then
		local pg = playerGui
		if pg and inst:IsDescendantOf(pg) then
			task.delay(0.3, function()
				if alive and inst.Parent then
					queueButton(inst)
				end
			end)
		end
	end
end

