----------------------------------------------------------------
-- Roblox -> tabel data
----------------------------------------------------------------
local function readPose(pose)
	local e = {
		Name = pose.Name,
		CFrame = { pose.CFrame:GetComponents() },
		EasingStyle = pose.EasingStyle.Value,
		EasingDirection = pose.EasingDirection.Value,
		Weight = pose.Weight,
		Children = {},
	}
	for _, sub in ipairs(pose:GetChildren()) do
		if sub:IsA("Pose") then
			e.Children[#e.Children + 1] = readPose(sub)
		end
	end
	return e
end

local function readSequence(ks)
	local data = {
		Loop = ks.Loop,
		Priority = ks.Priority.Value,
		Keyframes = {},
	}
	pcall(function()
		data.HipHeight = ks.AuthoredHipHeight
	end)
	for _, kf in ipairs(ks:GetKeyframes()) do
		local k = { Time = kf.Time, Name = kf.Name, Poses = {}, Markers = {} }
		for _, c in ipairs(kf:GetChildren()) do
			if c:IsA("Pose") then
				k.Poses[#k.Poses + 1] = readPose(c)
			elseif c:IsA("KeyframeMarker") then
				k.Markers[#k.Markers + 1] = { Name = c.Name, Value = c.Value }
			end
		end
		data.Keyframes[#data.Keyframes + 1] = k
	end
	table.sort(data.Keyframes, function(a, b)
		return a.Time < b.Time
	end)
	return data
end

-- ambil KeyframeSequence: KSP dulu, fallback GetObjects
local function loadSequence(id)
	local url = "rbxassetid://" .. id
	local ok, ks = pcall(function()
		return KSP:GetKeyframeSequenceAsync(url)
	end)
	if ok and ks then
		return ks
	end
	local firstErr = ok and "kosong" or tostring(ks)
	local ok2, objs = pcall(function()
		return game:GetObjects(url)
	end)
	if ok2 and objs then
		for _, o in ipairs(objs) do
			if o:IsA("KeyframeSequence") then
				return o
			end
		end
	end
	return nil, firstErr
end

local function fetchData(id)
	if cache[id] then
		return cache[id]
	end
	local ks, err = loadSequence(id)
	if not ks then
		return nil, err
	end
	local ok, data = pcall(readSequence, ks)
	pcall(function()
		ks:Destroy()
	end)
	if not ok then
		return nil, tostring(data)
	end
	cache[id] = data
	return data
end

----------------------------------------------------------------
-- Nama asli (katalog Roblox)
----------------------------------------------------------------
local PENDING = {}
local infoCache = {} -- id -> info table | false (gagal) | PENDING (lagi diminta)

local function isTransient(err)
	err = tostring(err):lower()
	return err:find("429", 1, true) ~= nil
		or err:find("throttl", 1, true) ~= nil
		or err:find("too many", 1, true) ~= nil
		or err:find("timed out", 1, true) ~= nil
		or err:find("timeout", 1, true) ~= nil
		or err:find("50%d") ~= nil
end

-- info asset dari katalog; di-cache. Yield. Gagal permanen (private/dihapus) = nil, ga di-retry.
local function getInfo(id)
	local c = infoCache[id]
	while c == PENDING and alive do
		task.wait(0.1)
		c = infoCache[id]
	end
	if c == PENDING then
		return nil
	end
	if c ~= nil then
		return c or nil
	end
	infoCache[id] = PENDING
	local info
	for attempt = 1, NAME_RETRIES do
		local ok, res = pcall(function()
			return MPS:GetProductInfo(tonumber(id), Enum.InfoType.Asset)
		end)
		if ok and type(res) == "table" then
			info = res
			break
		end
		if ok or not isTransient(res) or attempt == NAME_RETRIES then
			break
		end
		task.wait(attempt) -- backoff kalau kena rate limit
	end
	infoCache[id] = info or false
	return info
end

local function resolveName(e)
	if e.realName then
		return e.realName
	end
	local info = getInfo(e.id)
	local name = pickName(info and info.Name, e.name)
	e.realName = name
	return name
end

-- antrean pelan buat label GUI (satu worker, ada jeda biar ga kena rate limit)
local nameQueue, queueRunning = {}, false
local function queueName(e, onDone)
	nameQueue[#nameQueue + 1] = { e = e, cb = onDone }
	if queueRunning then
		return
	end
	queueRunning = true
	task.spawn(function()
		while alive and #nameQueue > 0 do
			local job = table.remove(nameQueue, 1)
			local needNet = infoCache[job.e.id] == nil
			resolveName(job.e)
			if job.cb then
				pcall(job.cb)
			end
			if needNet then
				task.wait(NAME_DELAY)
			end
		end
		queueRunning = false
	end)
end

----------------------------------------------------------------
-- Tulis file
----------------------------------------------------------------

local function writeOut(base, xml)
	if not canWrite then
		return nil
	end
	local p = FOLDER .. "/" .. base .. ".rbxmx"
	if pcall(writefile, p, xml) then
		return p
	end
	-- beberapa executor nolak ekstensi asing -> .txt, tinggal rename ke .rbxmx
	p = FOLDER .. "/" .. base .. ".txt"
	if pcall(writefile, p, xml) then
		return p
	end
	return nil
end

local function dump(rawId)
	local id = parseId(rawId)
	if not id then
		return nil, "id ga valid"
	end
	local e = found[id] or { id = id, name = "?", source = "manual" }
	local data, err = fetchData(id)
	if not data then
		return nil, err
	end
	local name = resolveName(e)
	local item = { name = name, data = data, assetId = INCLUDE_ANIMATION_REF and assetUrl(id) or nil }
	local xml = toXML({ item })
	local path = writeOut(safeName(name) .. "_" .. id, xml)
	if path then
		return path
	end
	if type(setclipboard) == "function" then
		setclipboard(xml)
		return "clipboard (executor ga punya writefile)"
	end
	return nil, "ga bisa nulis file / clipboard"
end

local dumping = false
local function dumpAll()
	if dumping then
		return
	end
	dumping = true
	local total, okN, items, failed, index = #order, 0, {}, {}, {}
	for i, e in ipairs(order) do
		if not alive then
			break
		end
		local name = resolveName(e)
		setStatus(("dump %d/%d: %s"):format(i, total, name))
		local data = fetchData(e.id)
		local line = assetUrl(e.id) .. " | " .. (name:gsub("[\r\n]+", " ")) .. " | " .. e.source
		index[#index + 1] = line
		if data then
			local item = { name = name, data = data, assetId = INCLUDE_ANIMATION_REF and assetUrl(e.id) or nil }
			items[#items + 1] = item
			if writeOut(safeName(name) .. "_" .. e.id, toXML({ item })) then
				okN = okN + 1
			end
		else
			failed[#failed + 1] = line
		end
		task.wait()
	end
	if #items > 0 then
		writeOut("_ALL", toXML(items))
	end
	if canWrite then
		pcall(writefile, FOLDER .. "/_ids.txt", table.concat(index, "\n"))
		pcall(writefile, FOLDER .. "/_failed.txt", table.concat(failed, "\n"))
	end
	setStatus(("selesai: %d ok, %d gagal -> %s/"):format(okN, #failed, FOLDER))
	print(("[AnimRip] %d ok, %d gagal. File ada di %s/"):format(okN, #failed, FOLDER))
	dumping = false
end

local function playId(id)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false, "karakter belum ada"
	end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local ks, err = loadSequence(id)
	if not ks then
		return false, err
	end
	local ok, res = pcall(function()
		local hash = KSP:RegisterKeyframeSequence(ks)
		local anim = Instance.new("Animation")
		anim.AnimationId = hash
		local tr = animator:LoadAnimation(anim)
		tr.Priority = Enum.AnimationPriority.Action
		tr:Play()
		return tr
	end)
	pcall(function()
		ks:Destroy()
	end)
	if not ok then
		return false, tostring(res)
	end
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0.1)
		end)
	end
	currentTrack = res
	return true
end

----------------------------------------------------------------
-- Scanner
----------------------------------------------------------------
local function safeFullName(inst)
	local ok, n = pcall(function()
		return inst:GetFullName()
	end)
	return ok and n or inst.Name
end

local function add(rawId, name, source)
	if not rawId or rawId == "" then
		return
	end
	local id = parseId(rawId)
	if not id or found[id] then
		return
	end
	local e = { id = id, name = name or "?", source = source or "?" }
	found[id] = e
	order[#order + 1] = e
	if setCount then
		setCount(#order)
	end
	if addRow then
		pcall(addRow, e)
	end
end

local function watchAnimator(animator)
	if animators[animator] then
		return
	end
	animators[animator] = true
	keep(animator.AnimationPlayed:Connect(function(track)
		local anim = track.Animation
		if anim then
			add(anim.AnimationId, track.Name, "played@" .. safeFullName(animator))
		end
	end))
end

local function onInstance(inst)
	if inst:IsA("Animation") then
		add(inst.AnimationId, inst.Name, safeFullName(inst))
		keep(inst:GetPropertyChangedSignal("AnimationId"):Connect(function()
			add(inst.AnimationId, inst.Name, safeFullName(inst))
		end))
	elseif inst:IsA("Animator") then
		watchAnimator(inst)
	end
end

