-- worker analisis tombol GUI
task.spawn(function()
	while alive do
		local n = 0
		workerBusy = #btnQueue > 0
		while alive and #btnQueue > 0 and n < 20 do
			local btn = table.remove(btnQueue)
			queuedBtn[btn] = nil
			if btn.Parent and not isOwnGui(btn) then
				local ok, err = pcall(analyzeButton, btn)
				if not ok then
					log("analyze error:", tostring(err))
				end
			end
			n = n + 1
		end
		workerBusy = #btnQueue > 0
		task.wait(n > 0 and 0.05 or 0.3)
	end
end)

-- safety net: animasi yang lagi diputar (server-side / belum ke-hook)
task.spawn(function()
	while alive do
		for animator in pairs(animators) do
			if animator.Parent == nil then
				animators[animator] = nil
			else
				pcall(function()
					for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
						onTrack(animator, tr, false)
					end
				end)
			end
		end
		task.wait(CFG.POLL_INTERVAL)
	end
end)

-- render UI (debounce)
