		return resolveName(found[id] or { id = id, name = "?", source = "manual" })
	end,
	assetId = function(rawId)
		local id = parseId(rawId)
		return id and assetUrl(id) or nil
	end,
	list = order,
	toXML = toXML,
	destroy = destroy,
}

