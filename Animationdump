----------------------------------------------------------------
-- Play (preview)
----------------------------------------------------------------
local function playId(id)
	local animator = getAnimator(true)
	if not animator then
		return false, "karakter belum ada"
	end
	local ks, err = loadSequence(id)
	if not ks then
		return false, err
	end
	local ok, res = pcall(function()
		local anim = Instance.new("Animation")
		local hashOk, hash = pcall(function()
			return KSP:RegisterKeyframeSequence(ks)
		end)
		anim.AnimationId = (hashOk and hash) or assetUrl(id)
		local tr = animator:LoadAnimation(anim)
		tr.Priority = Enum.AnimationPriority.Action
		tr:Play()
		return tr
	end)
	pcall(function()
		ks:Destroy()
	end)
	if not ok then
		return false, tostring(res)
	end
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0.1)
		end)
	end
	currentTrack = res
	return true
end

