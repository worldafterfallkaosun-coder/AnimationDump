--[[
	Animation ID Dumper  (Roblox / Delta)

	Ngumpulin semua ID animasi yang ketemu di game. CUMA ID-nya:
	ga narik keyframe, ga bikin .rbxm / .rbxmx.

	Sumber ID:
	  - semua instance Animation (termasuk yang dibikin runtime & nil instances)
	  - animasi yang lagi/pernah diputar (player + NPC)

	Output: workspace/AnimDump/ids.txt         -> rbxassetid://<id>, satu per baris
	        workspace/AnimDump/ids_detail.txt  -> <id> | <nama> | <sumber>
	(DUMP ALL juga nyalin ids.txt ke clipboard kalau executor support)

	API:
	  getgenv().AnimRip.dumpAll()  -> tulis file + copy clipboard
	  getgenv().AnimRip.ids()      -> string "rbxassetid://..." (satu per baris)
	  getgenv().AnimRip.list       -> daftar entry {id, name, source}
	  getgenv().AnimRip.destroy()
]]

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local KSP = game:GetService("KeyframeSequenceProvider")
local lp = Players.LocalPlayer

local FOLDER = "AnimDump"
local POLL_INTERVAL = 0.5
local MAX_ROWS = 300 -- batas baris GUI (DUMP ALL tetap ngitung semuanya)

----------------------------------------------------------------
-- Setup
----------------------------------------------------------------
local env = (getgenv and getgenv()) or _G
if env.AnimRip and env.AnimRip.destroy then
	pcall(env.AnimRip.destroy)
end

local canWrite = type(writefile) == "function"
local canClip = type(setclipboard) == "function"
if canWrite and type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(FOLDER) then
	pcall(makefolder, FOLDER)
end

local alive = true
local conns = {}
local found = {} -- id -> entry
local order = {} -- urutan ketemu
local animators = {}
local currentTrack
local rowCount = 0
local addRow, setStatus, setCount -- diisi di bagian UI

local function keep(c)
	table.insert(conns, c)
	return c
end

----------------------------------------------------------------
-- Dump ID
----------------------------------------------------------------
local function assetUrl(id)
	return "rbxassetid://" .. id
end

local function ids()
	local t = {}
	for i, e in ipairs(order) do
		t[i] = assetUrl(e.id)
	end
	return table.concat(t, "\n")
end

local function detail()
	local t = {}
	for i, e in ipairs(order) do
		t[i] = e.id .. " | " .. e.name .. " | " .. e.source
	end
	return table.concat(t, "\n")
end

local function copy(text)
	if not canClip then
		return false
	end
	return (pcall(setclipboard, text))
end

local function dumpAll()
	if #order == 0 then
		setStatus("belum ada animasi ketemu")
		return false
	end
	local plain = ids()
	local saved = false
	if canWrite then
		saved = (pcall(writefile, FOLDER .. "/ids.txt", plain))
		pcall(writefile, FOLDER .. "/ids_detail.txt", detail())
	end
	local copied = copy(plain)

	local where = {}
	if saved then
		where[#where + 1] = FOLDER .. "/ids.txt"
	end
	if copied then
		where[#where + 1] = "clipboard"
	end
	local msg
	if #where > 0 then
		msg = ("%d id -> %s"):format(#order, table.concat(where, " + "))
	else
		msg = ("%d id, tapi executor ga punya writefile/setclipboard"):format(#order)
	end
	setStatus(msg)
	print("[AnimRip] " .. msg)
	return true
end

----------------------------------------------------------------
-- Preview (PLAY)
----------------------------------------------------------------
-- ambil KeyframeSequence buat diputar: KSP dulu, fallback GetObjects
local function loadSequence(id)
	local url = assetUrl(id)
	local ok, ks = pcall(function()
		return KSP:GetKeyframeSequenceAsync(url)
	end)
	if ok and ks then
		return ks
	end
	local firstErr = ok and "kosong" or tostring(ks)
	local ok2, objs = pcall(function()
		return game:GetObjects(url)
	end)
	if ok2 and objs then
		for _, o in ipairs(objs) do
			if o:IsA("KeyframeSequence") then
				return o
			end
		end
	end
	return nil, firstErr
end

local function playId(id)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false, "karakter belum ada"
	end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local ks, err = loadSequence(id)
	if not ks then
		return false, err
	end
	local ok, res = pcall(function()
		local hash = KSP:RegisterKeyframeSequence(ks)
		local anim = Instance.new("Animation")
		anim.AnimationId = hash
		local tr = animator:LoadAnimation(anim)
		tr.Priority = Enum.AnimationPriority.Action
		tr:Play()
		return tr
	end)
	pcall(function()
		ks:Destroy()
	end)
	if not ok then
		return false, tostring(res)
	end
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0.1)
		end)
	end
	currentTrack = res
	return true
end

----------------------------------------------------------------
-- Scanner
----------------------------------------------------------------
local function safeFullName(inst)
	local ok, n = pcall(function()
		return inst:GetFullName()
	end)
	return ok and n or inst.Name
end

local function add(rawId, name, source)
	if not rawId or rawId == "" then
		return
	end
	local id = tostring(rawId):match("%d+")
	if not id or id == "0" or found[id] then
		return
	end
	local e = { id = id, name = name or "?", source = source or "?" }
	found[id] = e
	order[#order + 1] = e
	if setCount then
		setCount(#order)
	end
	if addRow then
		pcall(addRow, e)
	end
end

local function watchAnimator(animator)
	if animators[animator] then
		return
	end
	animators[animator] = true
	keep(animator.AnimationPlayed:Connect(function(track)
		local anim = track.Animation
		if anim then
			add(anim.AnimationId, track.Name, "played@" .. safeFullName(animator))
		end
	end))
end

local function onInstance(inst)
	if inst:IsA("Animation") then
		add(inst.AnimationId, inst.Name, safeFullName(inst))
		keep(inst:GetPropertyChangedSignal("AnimationId"):Connect(function()
			add(inst.AnimationId, inst.Name, safeFullName(inst))
		end))
	elseif inst:IsA("Animator") then
		watchAnimator(inst)
	end
end

