local function destroy()
	alive = false
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	if currentTrack then
		pcall(function()
			currentTrack:Stop(0)
		end)
	end
	gui:Destroy()
end

